# Vikunja 配置（install-server.sh 会生成一份带随机密钥的，放在数据目录里）
# 完整配置项见 https://vikunja.io/docs/config-options/

# 用来签发登录 token 的密钥，务必换成随机长字符串：openssl rand -hex 32
VIKUNJA_SERVICE_SECRET=change-me

# 浏览器 / 客户端访问 Vikunja 的地址。只在本机用就写 localhost；
# 要让手机等局域网设备访问，改成这台电脑的局域网 IP
VIKUNJA_SERVICE_PUBLICURL=http://localhost:3456/

# 服务端时区（逾期提醒等按它算；客户端各自按账号时区显示）
VIKUNJA_SERVICE_TIMEZONE=Asia/Shanghai

VIKUNJA_DATABASE_TYPE=sqlite
VIKUNJA_DATABASE_PATH=/db/vikunja.db

# 注册完自己的账号后可以改成 false
VIKUNJA_SERVICE_ENABLEREGISTRATION=true
