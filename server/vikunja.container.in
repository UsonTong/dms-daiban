# Vikunja 后端（Podman Quadlet 用户服务）。由 scripts/install-server.sh 生成到
# ~/.config/containers/systemd/vikunja.container，@DATA_DIR@ 会被替换成数据目录。
[Unit]
Description=Vikunja（待办后端）

[Container]
ContainerName=vikunja
Image=docker.io/vikunja/vikunja:latest
PublishPort=3456:3456
EnvironmentFile=@DATA_DIR@/vikunja.env
Volume=@DATA_DIR@/files:/app/vikunja/files:Z
Volume=@DATA_DIR@/db:/db:Z
UserNS=keep-id

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=default.target
